    {
      "name": "1. Events (POST /api/events)",
      "item": [
        {
          "name": "1. ASSIGNMENT_CREATED - call technician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ]
            },
            "description": "Calls the technician (2 attempts). Press ack_digit to accept, 9 to reject. Team leader / manager are called on escalation; remove them from recipients to skip escalation calls. Expected: 202 accepted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{ticket_id}}-ASSIGN-{{$timestamp}}\",\n  \"event_type\": \"ASSIGNMENT_CREATED\",\n  \"event_time\": \"{{$isoTimestamp}}\",\n  \"version\": \"{{$timestamp}}\",\n  \"ticket\": {\n    \"ticket_id\": \"{{ticket_id}}\",\n    \"alarm_id\": \"ALM-77\",\n    \"assignment_id\": \"{{assignment_id}}\",\n    \"site_number\": \"2040\",\n    \"site_name\": \"Olaya Branch, Riyadh\",\n    \"severity\": \"High\",\n    \"status\": \"Assigned\",\n    \"alarm_status\": \"Active\",\n    \"description\": \"ATM cash dispenser fault\"\n  },\n  \"ack_digit\": \"1\",\n  \"callback_url\": \"{{callback_url}}\",\n  \"recipients\": [\n    {\n      \"role\": \"technician\",\n      \"name\": \"Ahmed\",\n      \"mobile\": \"{{technician_mobile}}\",\n      \"language\": \"en\"\n    },\n    {\n      \"role\": \"team_leader\",\n      \"name\": \"Imran\",\n      \"mobile\": \"{{team_leader_mobile}}\",\n      \"language\": \"ur\"\n    },\n    {\n      \"role\": \"manager\",\n      \"name\": \"Sara\",\n      \"mobile\": \"{{manager_mobile}}\",\n      \"language\": \"en\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1b. ASSIGNMENT_CREATED + WAIT for technician answer (single API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/events?wait=true&until=technician&timeout=90",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "wait",
                  "value": "true"
                },
                {
                  "key": "until",
                  "value": "technician"
                },
                {
                  "key": "timeout",
                  "value": "90"
                }
              ]
            },
            "description": "Same as request 1, but the response waits until the technician answers: call_result = accepted | rejected | no_response | cancelled (HTTP 200), or pending if timeout seconds pass first (HTTP 202, the calls keep running). until=final waits for the escalation calls too. Set your client timeout above the timeout value (technician part takes up to ~3 min: 25 s ring + 60 s gap + 2nd call).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{ticket_id}}-ASSIGN-{{$timestamp}}\",\n  \"event_type\": \"ASSIGNMENT_CREATED\",\n  \"event_time\": \"{{$isoTimestamp}}\",\n  \"version\": \"{{$timestamp}}\",\n  \"ticket\": {\n    \"ticket_id\": \"{{ticket_id}}\",\n    \"alarm_id\": \"ALM-77\",\n    \"assignment_id\": \"{{assignment_id}}\",\n    \"site_number\": \"2040\",\n    \"site_name\": \"Olaya Branch, Riyadh\",\n    \"severity\": \"High\",\n    \"status\": \"Assigned\",\n    \"alarm_status\": \"Active\",\n    \"description\": \"ATM cash dispenser fault\"\n  },\n  \"ack_digit\": \"1\",\n  \"callback_url\": \"{{callback_url}}\",\n  \"recipients\": [\n    {\n      \"role\": \"technician\",\n      \"name\": \"Ahmed\",\n      \"mobile\": \"{{technician_mobile}}\",\n      \"language\": \"en\"\n    },\n    {\n      \"role\": \"team_leader\",\n      \"name\": \"Imran\",\n      \"mobile\": \"{{team_leader_mobile}}\",\n      \"language\": \"ur\"\n    },\n    {\n      \"role\": \"manager\",\n      \"name\": \"Sara\",\n      \"mobile\": \"{{manager_mobile}}\",\n      \"language\": \"en\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Duplicate check - send twice (2nd = duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
