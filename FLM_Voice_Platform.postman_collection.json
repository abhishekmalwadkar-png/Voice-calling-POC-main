{
  "info": {
    "name": "FLM Voice Call Platform",
    "description": "FLM Helpdesk voice call platform (Twilio). api_key is pre-filled from the server's .env - do not share this file outside the team. base_url = the server on port 80. Every /api/* request sends X-API-Key through the collection auth. Requests 1, 3 and the follow-up place REAL calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
