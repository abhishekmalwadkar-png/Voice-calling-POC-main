  "item": [
    {
      "name": "0. Authentication & Authorization (/api/authenticate & /api/authorize)",
      "item": [
        {
          "name": "1. Authenticate (login with username & password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (pm.response.code === 200 && data.token) {",
                  "    pm.collectionVariables.set(\"auth_token\", data.token);",
                  "}",
                  "if (pm.response.code === 200 && data.api_key) {",
                  "    pm.collectionVariables.set(\"api_key\", data.api_key);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/authenticate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authenticate"
              ]
            },
            "description": "Pass username and password to authenticate. Returns session Bearer token and sets auth_token / api_key automatically."
          }
        },
        {
          "name": "2. Verify Authorization (GET /api/authorize)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/authorize",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authorize"
              ]
            },
            "description": "Verifies if the current Bearer token or API key is valid and authorized. Returns user profile and authorization status."
          }
        },
        {
          "name": "3. Authorize with Credentials (POST /api/authorize)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (pm.response.code === 200 && data.token) {",
                  "    pm.collectionVariables.set(\"auth_token\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/authorize",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authorize"
              ]
            },
            "description": "Directly authorizes user credentials, returns authorization status and issues an active session token."
          }
        }
      ]
    },
