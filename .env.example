# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (Console > Phone Numbers > Buy a number), E.164 e.g. +15551234567
TWILIO_FROM_NUMBER=

# ---- Technician calls (PDF p.2-3) ----
TECH_MAX_ATTEMPTS=2
# Seconds between technician attempt 1 and 2
TECH_RETRY_INTERVAL_SEC=10
# Seconds the phone rings before it counts as not picked up
RING_TIMEOUT_SEC=25

# ---- Escalation calls (PDF p.5) ----
TL_MAX_ATTEMPTS=1
MANAGER_MAX_ATTEMPTS=2
MANAGER_RETRY_INTERVAL_SEC=10

# ---- Follow-up reminder (PDF p.4) ----
# 0 = you trigger it: POST /api/tickets/<ticket_id>/followup after 15 min. >0 = internal timer in seconds
FOLLOWUP_REMINDER_SEC=0

# ---- Keys and language ----
DEFAULT_ACK_DIGIT=1
DEFAULT_REJECT_DIGIT=9
# Used when an event gives no language for a recipient ("ask" in an event plays the menu)
DEFAULT_LANGUAGE=en

# ---- Contact guard: hold calls when the last event for a ticket is older than this (0 = off) ----
STATE_MAX_AGE_SEC=0

# ---- Optional: one URL that receives all webhook notifications (per-event callback_url wins) ----
RESULT_WEBHOOK_URL=

# ---- Webhook base URL ----
# Leave empty to auto-start a cloudflared quick tunnel, or set your own (e.g. ngrok URL)
PUBLIC_BASE_URL=
PORT=80

# 1 = don't call Twilio, just log (simulate_test.py sets this itself)
DRY_RUN=0

# ---- Call language menu (press 1, 2, 3... in this order). Options: en, ar, ur, hi ----
LANGUAGES=en,hi,ar,ur

# ---- API security: callers of /api/* must send header  X-API-Key: <this value> ----
API_KEY=

# ---- AutomationEdge WhatsApp Integration ----
AE_AUTH_SECRET=aistudio_qa
AE_AUTH_URL=https://dev-p280.ac2.automationedge.com/authenticate
AE_PUSH_URL=https://dev-p280.ac2.automationedge.com/api/push-notifications
AE_SERVICE_URL=http://localhost:3978/whatsapp
AE_BOT_ID=717940961400025

